{
  "name": "euracciai-modern-site",
  "version": "1.0.1",
  "description": "Modern Node.js website based only on public content from euracciai.it",
  "main": "build/server.js",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node build/server.js",
    "dev": "tsx watch server.ts",
    "build:static": "npm run build && node build/build-static.js",
    "check:static": "node scripts/check-static-build.js",
    "check": "npm run typecheck && npm run build:static && npm run check:static"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
